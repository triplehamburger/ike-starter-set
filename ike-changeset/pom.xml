<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>ike-changeset</artifactId>
    <packaging>jar</packaging>

    <name>Ike Change Set</name>
    <description>
        The ledger's export module: ike:knowledge-export replays the ledger stated-only
        and attaches the full standalone unreasoned protobuf (classifier:
        unreasoned-pb, ike-issues#933) — the reasoner-blind replay is the whole set,
        not a delta. The module name looks ahead to genuine change-set (delta)
        artifacts, whose authoring doctrine is ike-issues#844; the changeset
        classifier is reserved until then.
    </description>

    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-terms</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- The knowledge-pipeline implementation, resolved by ServiceLoader inside
             the goal's forked seam. -->
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>${ike-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>export-knowledge-unreasoned</id>
                        <goals>
                            <goal>knowledge-export</goal>
                        </goals>
                        <configuration>
                            <!-- Classifier defaults to unreasoned-pb (ike-issues#933);
                                 glossary from the same loaded store — one
                                 materialization, both artifacts. -->
                            <konceptsYmlFile>${project.build.directory}/ike-koncepts.yml</konceptsYmlFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
