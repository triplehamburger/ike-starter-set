<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>ike-kb</artifactId>
    <packaging>pom</packaging>

    <name>Ike Knowledge Base</name>
    <description>
        The full-cycle knowledge base: the base plus this set's ledger export,
        assembled and classified by ike:kb-assemble, exported as the standalone
        reasoned-pb protobuf, and installed into the data-source directory for
        verification in Komet. ike:knowledge-attach publishes the unreasoned-pb
        and reasoned-pb exports under the ike-starter-set aggregator coordinate
        (ike-issues#933). Verification edits are captured under the installed
        store's changeSets directory and feed the next iteration as CHANGESET
        file inputs below.
    </description>

    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>network.ike.knowledge</groupId>
            <artifactId>ike-knowledge-provider</artifactId>
            <version>${ike-knowledge-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Build-order only: the change set below must exist before assembly. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-changeset</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>${ike-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>assemble-knowledge-base</id>
                        <goals>
                            <goal>kb-assemble</goal>
                        </goals>
                        <configuration>
                            <inputs>
                                <input>PB dev.ikm.data.tinkar:tinkar-starter-data:zip:reasoned-pb:20251009</input>
                                <input>PB ${project.basedir}/../ike-changeset/target/ike-changeset-${project.version}-unreasoned-pb.zip</input>
                                <!-- Next iteration: change sets captured during Komet
                                     verification load on top, e.g.
                                <input>CHANGESET ${user.home}/Solor/ike-kb/changeSets/User_yyyyMMdd_HHmmss_ike-cs.zip</input>
                                -->
                            </inputs>
                            <installDirectory>${user.home}/Solor/ike-kb</installDirectory>
                            <!-- The classified store's standalone export; attached
                                 under the aggregator coordinate below, not this
                                 module's (ike-issues#933). -->
                            <reasonedPb>true</reasonedPb>
                            <attachReasonedPb>false</attachReasonedPb>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-unreasoned-roundtrip</id>
                        <goals>
                            <goal>knowledge-verify</goal>
                        </goals>
                        <configuration>
                            <!-- The consumer-import round trip (ike-issues#951): the
                                 unreasoned export must load over the same base the
                                 assembly used, manifest and count checks intact.
                                 PRESENCE only: a FIT_REFERENCES sweep here would judge
                                 the whole store including the base's own health — and
                                 the 20251009 baseline carries 37 semantics of a pattern
                                 it does not carry (upstream defect, surfaced by this
                                 gate and excluded from our reasoned export). The full
                                 sweep runs on the standalone reasoned artifact below,
                                 where store content IS the artifact. -->
                            <artifact>${project.basedir}/../ike-changeset/target/ike-changeset-${project.version}-unreasoned-pb.zip</artifact>
                            <baseInputs>
                                <baseInput>PB dev.ikm.data.tinkar:tinkar-starter-data:zip:reasoned-pb:20251009</baseInput>
                            </baseInputs>
                            <checks>
                                <check>PRESENCE</check>
                            </checks>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-reasoned-roundtrip</id>
                        <goals>
                            <goal>knowledge-verify</goal>
                        </goals>
                        <configuration>
                            <!-- The reasoned export is standalone: it must load into an
                                 empty store and resolve every reference on its own —
                                 exactly the Komet download-dialog import
                                 (ike-issues#951). -->
                            <artifact>${project.build.directory}/${project.artifactId}-${project.version}-reasoned-pb.zip</artifact>
                            <checks>
                                <check>PRESENCE</check>
                                <check>FIT_REFERENCES</check>
                            </checks>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-set-protobufs</id>
                        <goals>
                            <goal>knowledge-attach</goal>
                        </goals>
                        <configuration>
                            <!-- The set's released coordinate is the aggregator:
                                 network.ike.foundation:ike-starter-set:<v>:{unreasoned-pb|reasoned-pb}.
                                 Requires the reactor root's installAtEnd/deployAtEnd
                                 (ike-issues#933). -->
                            <targetArtifactId>ike-starter-set</targetArtifactId>
                            <attachments>
                                <attachment>unreasoned-pb ${project.basedir}/../ike-changeset/target/ike-changeset-${project.version}-unreasoned-pb.zip</attachment>
                                <attachment>reasoned-pb ${project.build.directory}/${project.artifactId}-${project.version}-reasoned-pb.zip</attachment>
                            </attachments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
