<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>131</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.foundation</groupId>
    <artifactId>ike-starter-set</artifactId>
    <version>1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ike Starter Set</name>
    <description>
        IkeFoundation starter set: the ledger-form content set for Ike.
        The source is an append-only version ledger (declared stamps, birth-FQN
        identity); building replays the ledger; the released artifacts are the
        standalone protobufs published under this aggregator coordinate —
        unreasoned-pb (stated-only) and reasoned-pb (classified, inferred results
        baked in) — with the changeset classifier reserved for genuine deltas
        (ike-issues#933; delta doctrine ike-issues#844).
        Generated by ike:starter-set-create; the SOP is the dev-knowledge-set-sop
        topic family in ike-lab-documents.
    </description>
    <url>https://ike.network/ike-starter-set/</url>
    <inceptionYear>2026</inceptionYear>

    <!-- Dual licensed (IKE-Network/ike-issues#952): CC BY for the knowledge
         content, Apache 2.0 alongside it — declared identically in every POM of
         this reactor and carried as concepts in the set itself. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <!-- Required: ike-parent's enforcer fails an inheriting project whose effective
         site URL still points at the in-reactor location (ike-issues#380/#383). -->
    <distributionManagement>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/ike-starter-set/</url>
        </site>
    </distributionManagement>

    <properties>
        <!-- The chronology-store authoring tier (ike-issues#822) landed on
             tinkar-core main with the chronology-builder substrate
             (ike-issues#867); main-line SNAPSHOTs until the release cascades. -->
        <chronology-store.version>1.127.2-SNAPSHOT</chronology-store.version>
        <ike-knowledge-provider.version>1-SNAPSHOT</ike-knowledge-provider.version>
        <!-- ike-maven-plugin 239 ships the #951 knowledge-verify round-trip gate;
             238 shipped the #933 export/attach goals. -->
        <ike-maven-plugin.version>239</ike-maven-plugin.version>
    </properties>

    <subprojects>
        <subproject>ike-terms</subproject>
        <subproject>ike-bindings</subproject>
        <subproject>ike-changeset</subproject>
        <subproject>ike-doc</subproject>
        <subproject>ike-kb</subproject>
    </subprojects>

    <build>
        <pluginManagement>
            <plugins>
                <!-- ike:knowledge-attach (ike-kb) attaches the pb exports under THIS
                     aggregator's GAV after the aggregator's own reactor position, so
                     publication must defer to session end — without at-end, the
                     attachments would silently never install or deploy
                     (ike-issues#933). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <configuration>
                        <installAtEnd>true</installAtEnd>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <deployAtEnd>true</deployAtEnd>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- ike-platform's inherited rules only require Java 21, so a JDK 24 build
                 passed the enforcer and then died inside ike-doc-maven-plugin. Same
                 execution, tighter rules, so the prerequisite is reported once, up front. -->
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-prerequisites</id>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>ike-starter-set requires Java 25+: network.ike.docs:ike-doc-maven-plugin (bound by ike-parent as a build extension) declares requiredJavaVersion 25.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[4.0.0-rc-5,)</version>
                                    <message>ike-starter-set requires Maven 4.0.0-rc-5+: network.ike.docs:ike-doc-maven-plugin declares requiredMavenVersion 4.0.0-rc-5.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
