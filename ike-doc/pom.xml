<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.foundation</groupId>
        <artifactId>ike-starter-set</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>ike-doc</artifactId>
    <packaging>pom</packaging>

    <name>Ike Starter Set — Guide</name>
    <description>
        Documentation for the IkeFoundation starter set. The comprehensive Koncept
        glossary renders from the koncepts.yml the change-set module extracts from
        the loaded store.
    </description>

    <!-- Dual licensed (IKE-Network/ike-issues#952); identical in every POM of
         this reactor. -->
    <licenses>
        <license>
            <name>Creative Commons Attribution 4.0 International</name>
            <url>https://creativecommons.org/licenses/by/4.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <pdf.source.document>ike-guide</pdf.source.document>
        <koncept-asciidoc-extension.version>94</koncept-asciidoc-extension.version>
        <koncepts.yml>${project.basedir}/../ike-changeset/target/ike-koncepts.yml</koncepts.yml>
    </properties>

    <dependencies>
        <!-- Build-order only: ensure doc extension builds before doc rendering -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-doc-extension</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Build-order only: the change-set module extracts the koncepts.yml this
             guide renders. -->
        <dependency>
            <groupId>network.ike.foundation</groupId>
            <artifactId>ike-changeset</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Same unreleased-ike-docs pilot override as koncept-asciidoc-extension
             above: the pattern-table row styles live in the shared docinfo, ahead
             of the pinned ike-docs release. Drop both when the pin catches up. -->
        <dependency>
            <groupId>network.ike.docs</groupId>
            <artifactId>ike-doc-resources</artifactId>
            <version>${koncept-asciidoc-extension.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <!-- Discovers every chapter declared anywhere in the reactor, validates the
                 hierarchy they form, and writes target/ike-hierarchy-index.json. Must run before
                 the guide renders: the include processor below reads only this index. -->
            <plugin>
                <groupId>network.ike.foundation</groupId>
                <artifactId>ike-hierarchy-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>hierarchy-index</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>index</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>network.ike.foundation</groupId>
                        <artifactId>ike-doc-extension</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>network.ike.foundation</groupId>
                        <artifactId>ike-hierarchy-model</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>network.ike.docs</groupId>
                        <artifactId>koncept-asciidoc-extension</artifactId>
                        <version>${koncept-asciidoc-extension.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <attributes>
                        <!-- The index the include processor reads, and the base every path in it
                             is resolved beneath. The base comes from Maven rather than from the
                             index, so the index cannot name a file outside the project. -->
                        <ike-hierarchy-index>${project.build.directory}/ike-hierarchy-index.json</ike-hierarchy-index>
                        <ike-hierarchy-base>${session.rootDirectory}</ike-hierarchy-base>
                        <koncept-definitions-file>${koncepts.yml}</koncept-definitions-file>
                        <koncept-glossary-all/>
                    </attributes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
